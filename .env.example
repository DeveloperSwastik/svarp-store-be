# ╔══════════════════════════════════════════════════════════════╗
# ║                    STORE BFF CONFIGURATION                  ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ─── Security / JWT ─────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT=100/minute

# ─────────────────────────────────────────────────────────────────
#                      MICROSERVICE CONNECTIONS
# ─────────────────────────────────────────────────────────────────

# ─── User Portal (Authentication & User Management) ────────────
USER_PORTAL_URL=http://localhost:8001
USER_PORTAL_API_KEY=
USER_PORTAL_API_SECRET=

# ─── Inventory Service ──────────────────────────────────────────
INVENTORY_SERVICE_URL=http://localhost:8002
INVENTORY_SERVICE_API_KEY=
INVENTORY_SERVICE_API_SECRET=

# ─── Order Service ──────────────────────────────────────────────
ORDER_SERVICE_URL=http://localhost:8003
ORDER_SERVICE_API_KEY=
ORDER_SERVICE_API_SECRET=

# ─── Payment Service ────────────────────────────────────────────
PAYMENT_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_API_KEY=
PAYMENT_SERVICE_API_SECRET=
